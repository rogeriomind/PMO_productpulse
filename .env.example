APP_ENV=local
APP_PORT=8000

DATABASE_URL=postgresql://pmo_agent:pmo_agent@postgres:5432/pmo_agent

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

DEBOUNCE_SECONDS=5

MAX_QUEUE_ATTEMPTS=3
QUEUE_LOCK_SECONDS=60
WORKER_SLEEP_SECONDS=2

RATE_LIMIT_MAX_MESSAGES=20
RATE_LIMIT_WINDOW_SECONDS=60

AGENT_API_URL=http://pmo-ai-agent-api:8010
AGENT_API_TOKEN=
AGENT_API_TIMEOUT_SECONDS=30
AGENT_API_RETRY_ATTEMPTS=3
AGENT_API_RETRY_BASE_SECONDS=1
AGENT_API_ENDPOINT=/v2/agent/events

AGENT_TENANT_ID=default
AGENT_DEFAULT_PROJECT_ID=
AGENT_TIMEZONE=America/Sao_Paulo

AGENT_TECHNICAL_FALLBACK_MESSAGE=O serviço está temporariamente indisponível. Tente novamente em alguns instantes.
PMO_AI_NETWORK_NAME=pmo_ai_network
